# Postgres connection used by Prisma (CLI and runtime)
DATABASE_URL="postgresql://brunoboeger@localhost:5432/research?schema=public"

# Dev auth seam: resolves the seeded dev user instead of a session. Refused in production.
AUTH_DISABLED=true
# Which seeded user the dev seam resolves: admin | editor | viewer
DEV_USER=admin

# Where transcripts and recordings are stored (per-source folders)
UPLOAD_DIR=./uploads
MAX_TRANSCRIPT_BYTES=20000000
MAX_RECORDING_BYTES=2000000000

# Mirror folder the seed imports (Dovetail-mirror shape). Default is the synthetic one.
MIRROR_DIR=./fixtures/mirror
